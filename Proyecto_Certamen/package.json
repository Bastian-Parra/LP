{
  "name": "proyecto_certamen",
  "version": "1.0.0",
  "description": "Simulador de Máquina de Turing",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "antlr": "antlr4 -Dlanguage=TypeScript -visitor src/grammar/Turing.g4 -o src/grammar/generated",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test:grammar": "tsx src/grammar/probarGramatica.ts"
  },
  "dependencies": {
    "antlr4": "^4.13.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
